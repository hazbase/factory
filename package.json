{
  "name": "@hazbase/factory",
  "version": "0.2.1",
  "description": "A CLI / SDK helper for deploying smart contracts via a shared Factory in the hazBase stack.",
  "author": "IndieSquare Inc <info@hazbase.com>",
  "keywords": [
    "hazBase",
    "backend",
    "factory",
    "cli",
    "web3",
    "typescript",
    "blockchain",
    "dapps",
    "evm",
    "ethereum"
  ],
  "homepage": "https://lp.hazbase.com/",
  "repository": "hazbase/factory",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.mjs"
    }
  },
  "bin": {
    "hazbase-factory": "./bin/hazbase-factory.js"
  },
  "files": [
    "dist",
    "bin",
    "hardhat"
  ],
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^11.1.0",
    "dotenv": "^16.5.0",
    "ethers": "^6.16.0",
    "execa": "^8.0.1",
    "figlet": "^1.8.1",
    "inquirer": "^12.6.1",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "hardhat": "2.25.0",
    "tsup": "^7.3.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "ws": "^8.21.0"
  }
}
